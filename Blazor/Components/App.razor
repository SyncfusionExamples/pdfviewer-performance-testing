<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>PDF Viewer performance (Blazor Server)</title>
    <link href="_content/Syncfusion.Blazor.Themes/bootstrap5.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <HeadOutlet @rendermode="RenderModeNoPrerender" />
</head>
<body>
    <Routes @rendermode="RenderModeNoPrerender" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Syncfusion.Blazor.SfPdfViewer/scripts/syncfusion-blazor-sfpdfviewer.min.js" type="text/javascript"></script>
    <script src="perf.js"></script>
</body>
</html>

@code {
    // Interactive Server without prerendering, so the page (and the load timer) starts once.
    private static readonly IComponentRenderMode RenderModeNoPrerender = new InteractiveServerRenderMode(prerender: false);
}
